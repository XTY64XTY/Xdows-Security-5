<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Xdows_Local</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PeNet" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="XdowsVirusFamilyRules.json">
      <LogicalName>Xdows_Local.XdowsVirusFamilyRules.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
