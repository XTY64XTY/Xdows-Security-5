<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Xdows_Security.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Xdows_Security"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer" xmlns:local.Views="using:Xdows_Security.Views"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="MoreScanListTemplate" x:DataType="local.Views:MoreScanItem">
            <Grid Padding="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" Margin="0,0,8,0" FontSize="16"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VirusRowTemplate" x:DataType="local.Views:VirusRow">
            <Grid Padding="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*" MinWidth="300"/>
                    <ColumnDefinition Width="1*" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          MinWidth="0"
                          Padding="0"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                          Tag="{x:Bind}"
                          Checked="OnVirusRowCheckedChanged"
                          Unchecked="OnVirusRowCheckedChanged"/>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind FilePath, Mode=OneWay}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2"
                           Text="{x:Bind DisplayName, Mode=OneWay}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem  l:Uids.Uid="ScanPage_MenuItem_Details"
                            Click="OnVirusRowDetailsClick"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem  l:Uids.Uid="ScanPage_MenuItem_Trust"
                            Click="OnVirusRowTrustClick"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE73E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem l:Uids.Uid="ScanPage_MenuItem_Handle"
                            Click="OnVirusRowHandleClick"
                            Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="64,4,64,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name="StatusText"
                   Grid.Row="0" Grid.Column="0"
                   FontSize="16"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"/>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="BackToVirusListButton" Click="OnBackToVirusListClick" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Tag="Visible" Spacing="8">
                    <FontIcon x:Name="BackToVirusListButtonIcon" Glyph="&#xE890;"/>
                    <TextBlock x:Name="BackToVirusListButtonText" l:Uids.Uid="ScanPage_BackToVirusListButtonText"/>
                </StackPanel>
            </Button>

            <Button x:Name="HandleAllButton" Click="OnHandleAllClick" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                    <TextBlock x:Name="HandleAllButtonText" l:Uids.Uid="ScanPage_HandleAllButtonText"/>
                </StackPanel>
            </Button>

            <Button x:Name="PauseScanButton" Click="OnPauseScanClick" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF5E7;"/>
                    <TextBlock l:Uids.Uid="ScanPage_PauseScanButtonText"/>
                </StackPanel>
            </Button>

            <Button x:Name="ResumeScanButton" Click="OnResumeScanClick" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;"/>
                    <TextBlock l:Uids.Uid="ScanPage_ResumeScanButtonText"/>
                </StackPanel>
            </Button>

            <Button x:Name="CancelScanButton" Click="OnCancelScanClick" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Grid>
                        <FontIcon x:Name="CancelScanButtonIcon" Glyph="&#xE711;" FontSize="16"/>
                        <ProgressRing x:Name="CancelScanButtonRing"
                                      Width="16" Height="16"
                                      IsActive="False"
                                      Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock l:Uids.Uid="ScanPage_CancelScanButtonText"/>
                </StackPanel>
            </Button>

            <SplitButton x:Name="ScanButton" Click="ScanButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                    <TextBlock x:Name="ScanButtonText" l:Uids.Uid="ScanPage_ScanButtonText"/>
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem l:Uids.Uid="ScanPage_ScanMenu_Quick" Tag="Quick" Click="OnScanMenuClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE945;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem l:Uids.Uid="ScanPage_ScanMenu_Full" Tag="Full" Click="OnScanMenuClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDA2;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem l:Uids.Uid="ScanPage_ScanMenu_File" Tag="File" Click="OnScanMenuClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem l:Uids.Uid="ScanPage_ScanMenu_Folder" Tag="Folder" Click="OnScanMenuClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem l:Uids.Uid="ScanPage_ScanMenu_More" Tag="More" Click="OnScanMenuClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE944;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </StackPanel>

        <ProgressBar x:Name="ScanProgress"
                     Grid.Row="1" Grid.ColumnSpan="2"
                     Margin="0,4,0,0"
                     Height="8"
                     CornerRadius="4"
                     Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                     Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                     Visibility="Collapsed"/>

        <TextBlock Name="ScanStatsText"
                   Grid.Row="2" Grid.ColumnSpan="2"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   VerticalAlignment="Center"
                   Margin="0,8,0,0"/>

        <Border x:Name="ThreatListBorder"
                Grid.Row="3" Grid.ColumnSpan="2"
                Margin="0,8,0,16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 左侧 4(自身) + 16(ListViewItem 内边距)，右侧 12(自身) + 12(ListViewItem 内边距)，
                     与 VirusRowTemplate 的内容区完全对齐 -->
                <Grid Grid.Row="0"
                      Padding="20,8,24,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*" MinWidth="300"/>
                        <ColumnDefinition Width="1*" MinWidth="120"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAllThreatsCheckBox"
                              Grid.Column="0"
                              IsChecked="True"
                              MinWidth="0"
                              Padding="0"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Click="OnSelectAllThreatsClick"/>
                    <TextBlock Grid.Column="1"
                               l:Uids.Uid="ScanPage_ListHeader_Path"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="2"
                               l:Uids.Uid="ScanPage_ListHeader_Threat"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <!-- 不自定义 ItemContainerStyle：默认样式（WinUI 2.3.9 generic.xaml 的 DefaultListViewItemStyle）
                     Padding 本来就是 16,0,12,0，表头的 20 就是按它算的；自己再写一份会把默认 Setter 全丢掉，悬浮/选中的圆角就没了 -->
                <ListView x:Name="VirusList"
                          Grid.Row="1"
                          DoubleTapped="VirusList_DoubleTapped"/>
            </Grid>
        </Border>
    </Grid>
</Page>
