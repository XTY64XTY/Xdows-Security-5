<Page
    x:Class="Xdows_Security.Views.SettingsHomePage"
    NavigationCacheMode="Enabled"
    Loaded="SettingsHomePage_Loaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:l="using:WinUI3Localizer">
    <ScrollViewer>
        <StackPanel x:Name="SettingsHomeContentPanel" Spacing="8" Margin="80,-12,80,48">
            <AutoSuggestBox x:Name="SettingsSearchBox"
                            AutomationProperties.AutomationId="SettingsHomeSearchBox"
                            l:Uids.Uid="SettingsPage_Search"
                            QueryIcon="Find"
                            TextChanged="SettingsSearchBox_TextChanged"
                            Margin="0,0,0,4" />

            <StackPanel x:Name="SettingsCategoriesPanel" Spacing="8">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>
                <toolkit:SettingsCard x:Name="PersonalizationCategoryCard"
                                      l:Uids.Uid="SettingsHome_Personalization"
                                      HeaderIcon="{ui:FontIcon Glyph=&#xE790;}"
                                      IsClickEnabled="True" Click="CategoryCard_Click" />
                <toolkit:SettingsCard x:Name="ScanningCategoryCard"
                                      l:Uids.Uid="SettingsHome_Scanning"
                                      HeaderIcon="{ui:FontIcon Glyph=&#xE773;}"
                                      IsClickEnabled="True" Click="CategoryCard_Click" />
                <toolkit:SettingsCard x:Name="ProtectionCategoryCard"
                                      l:Uids.Uid="SettingsHome_Protection"
                                      HeaderIcon="{ui:FontIcon Glyph=&#xEA18;}"
                                      IsClickEnabled="True" Click="CategoryCard_Click" />
                <toolkit:SettingsCard x:Name="FeaturesCategoryCard"
                                      l:Uids.Uid="SettingsHome_Features"
                                      HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}"
                                      IsClickEnabled="True" Click="CategoryCard_Click" />
                <toolkit:SettingsCard x:Name="QuarantineCategoryCard"
                                      l:Uids.Uid="SettingsHome_Quarantine"
                                      HeaderIcon="{ui:FontIcon Glyph=&#xE8B6;}"
                                      IsClickEnabled="True" Click="CategoryCard_Click" />
                <toolkit:SettingsCard x:Name="GeneralCategoryCard"
                                      l:Uids.Uid="SettingsHome_General"
                                      HeaderIcon="{ui:FontIcon Glyph=&#xE713;}"
                                      IsClickEnabled="True" Click="CategoryCard_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
