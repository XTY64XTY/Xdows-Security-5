<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Xdows_Security.Views.SettingsContentView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="using:CommunityToolkit.WinUI"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:l="using:WinUI3Localizer"
      mc:Ignorable="d">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="4" Margin="80,24,80,0" HorizontalAlignment="Stretch">
            <AutoSuggestBox x:Name="SettingsSearchBox"
                            l:Uids.Uid="SettingsPage_Search"
                            QueryIcon="Find"
                            TextChanged="SettingsSearchBox_TextChanged"
                            Margin="0,0,0,4"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch" />
            <StackPanel x:Name="SettingsContentPanel">
                <StackPanel x:Name="Category_Personalization" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                <toolkit:SettingsExpander
                              l:Uids.Uid="SettingsPage_Appearance_Theme"
                              HeaderIcon="{ui:FontIcon Glyph=&#xE790;}"
                              x:Name="Appearance_Theme"
                              Margin="0,0,0,4">
                    <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Theme_ComboBox_System" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Theme_ComboBox_Light" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Theme_ComboBox_Dark" />
                    </ComboBox>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                                      l:Uids.Uid="SettingsPage_Appearance_Theme_UseNotoSans"
                                      HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}"
                                      x:Name="Appearance_Theme_UseNotoSans">
                            <ToggleSwitch x:Name="UseNotoSansToggle"
                                          AutomationProperties.AutomationId="UseNotoSansToggle"
                                          Tag="UseNotoSansFont"
                                          Toggled="UseNotoSansToggle_Toggled" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander
                              l:Uids.Uid="SettingsPage_Appearance_Nav"
                              HeaderIcon="{ui:FontIcon Glyph=&#xE700;}"
                              x:Name="Appearance_Nav"
                              Margin="0,0,0,4">
                    <ComboBox x:Name="NavComboBox" SelectionChanged="NavComboBox_SelectionChanged">
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Nav_Left" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Nav_Top" />
                    </ComboBox>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Appearance_Nav_IsPaneToggleButtonInTitleBar"
                           HeaderIcon="{ui:FontIcon Glyph=&#xF165;}"
                           x:Name="SettingsPage_Appearance_Nav_IsPaneToggleButtonInTitleBar_Card">
                            <ToggleSwitch x:Name="SettingsPage_Appearance_Nav_IsPaneToggleButtonInTitleBar" Tag="IsPaneToggleButtonInTitleBar" Toggled="SettingsPage_Appearance_Nav_IsPaneToggleButtonInTitleBar_Toggled" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Appearance_Nav_LeftStyle"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE740;}"
                           x:Name="SettingsPage_Appearance_Nav_LeftStyle_Card">
                            <ComboBox x:Name="SettingsPage_Appearance_Nav_LeftStyleCombo" SelectionChanged="SettingsPage_Appearance_Nav_LeftStyleCombo_SelectionChanged">
                                <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Nav_LeftStyle_Tight" />
                                <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Nav_LeftStyle_Default" />
                                <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Nav_LeftStyle_Wide" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Appearance_Nav_IsBackButtonVisible"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE72B;}">
                            <ToggleSwitch x:Name="SettingsPage_Appearance_Nav_IsBackButtonVisible" Tag="IsBackButtonVisible" Toggled="SettingsPage_Appearance_Nav_IsBackButtonVisible_Toggled" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander
                   l:Uids.Uid="SettingsPage_Appearance_Backdrop"
                   HeaderIcon="{ui:FontIcon Glyph=&#xEF1F;}"
                   x:Name="Appearance_Backdrop"
                   Margin="0,0,0,4">
                    <ComboBox x:Name="BackdropComboBox" SelectionChanged="BackdropComboBox_SelectionChanged">
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Backdrop_Solid" Tag="Solid"/>
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Backdrop_Mica" Tag="Mica" x:Name="MicaOption"/>
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Backdrop_MicaAlt" Tag="MicaAlt" x:Name="MicaAltOption"/>
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Backdrop_Acrylic" Tag="Acrylic"/>
                    </ComboBox>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Appearance_Backdrop_Opacity"
                           HeaderIcon="{ui:FontIcon Glyph=&#xF5ED;}"
                           x:Name="Appearance_Backdrop_Opacity_Card">
                            <Slider x:Name="Appearance_Backdrop_Opacity" Value="100" ValueChanged="OpacitySlider_ValueChanged"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander
                   l:Uids.Uid="SettingsPage_Appearance_Sound"
                   HeaderIcon="{ui:FontIcon Glyph=&#xE8D6;}"
                   x:Name="Appearance_Sound"
                   Margin="0,0,0,4">
                    <ToggleSwitch x:Name="SoundEffectsToggle" Tag="SoundEffects" Toggled="SoundEffectsToggle_Toggled" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Appearance_Sound_SpatialAudio"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE7F5;}">
                            <ToggleSwitch x:Name="SpatialAudioToggle" Tag="SpatialAudio" Toggled="SpatialAudioToggle_Toggled" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard
                   l:Uids.Uid="SettingsPage_Appearance_Transition"
                   HeaderIcon="{ui:FontIcon Glyph=&#xE8E2;}"
                   x:Name="Appearance_Transition"
                   Margin="0,0,0,4">
                    <ComboBox x:Name="TransitionComboBox" SelectedIndex="0" SelectionChanged="TransitionComboBox_SelectionChanged">
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Transition_Default" Tag="Default" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Transition_Entrance" Tag="Entrance" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Transition_DrillIn" Tag="DrillIn" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Transition_Suppress" Tag="Suppress" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Transition_SlideFromRight" Tag="SlideFromRight" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Transition_SlideFromLeft" Tag="SlideFromLeft" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Appearance_Transition_Continuum" Tag="Continuum" />
                    </ComboBox>
                </toolkit:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="Category_Scanning" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                <toolkit:SettingsExpander
                           l:Uids.Uid="SettingsPage_Scan_IndexMode"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE773;}"
                           x:Name="Scan_IndexMode"
                           Margin="0,0,0,4">
                    <ComboBox x:Name="ScanIndexModeComboBox" SelectionChanged="ScanIndexModeComboBox_SelectionChanged">
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Scan_IndexMode_Parallel" Tag="Parallel" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Scan_IndexMode_After" Tag="After" />
                    </ComboBox>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_IndexMode_FastIndex"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE945;}">
                            <ToggleSwitch x:Name="FastIndexToggle"
                                          AutomationProperties.AutomationId="FastIndexToggle"
                                          Tag="UseFastIndexing"
                                          Toggled="Toggled_SaveToggleData" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_IndexMode_ScanProgress"
                           HeaderIcon="{ui:FontIcon Glyph=&#xF0B5;}"
                           x:Name="Scan_ScanProgress">
                            <ToggleSwitch x:Name="ScanProgressToggle" Tag="ShowScanProgress" Toggled="Toggled_SaveToggleData" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_IndexMode_TaskbarScanProgress"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}"
                           x:Name="Scan_TaskbarScanProgress">
                            <ToggleSwitch x:Name="TaskbarScanProgressToggle" Tag="ShowTaskbarScanProgress" IsOn="True" Toggled="Toggled_SaveToggleData" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander
                           VerticalAlignment="Top"
                           l:Uids.Uid="SettingsPage_Scan_BuiltInRuleEngine"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE71D;}"
                           x:Name="Scan_BuiltInRuleEngine"
                           Margin="0,0,0,4">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_BuiltInRuleEngine_ScanInside"
                           HeaderIcon="{ui:FontIcon Glyph=&#xF012;}">
                            <ToggleSwitch x:Name="ScanInsideToggle" Tag="ScanInside" Toggled="Toggled_SaveToggleData" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_BuiltInRuleEngine_VirusFamily"
                           HeaderIcon="{ui:FontIcon Glyph=&#xEBDA;}">
                            <ToggleSwitch x:Name="VirusFamilyToggle" Tag="VirusFamily" Toggled="VirusFamilyToggle_Toggled" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_BuiltInRuleEngine_InfectorCleaner"
                           HeaderIcon="{ui:FontIcon Glyph=&#xEA99;}">
                            <ToggleSwitch x:Name="InfectorCleanerToggle" Tag="InfectorCleaner" Toggled="Toggled_SaveToggleData" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_BuiltInRuleEngine_ExactRule"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE71C;}">
                            <ToggleSwitch x:Name="ExactRuleToggle" Tag="ExactRuleScan" Toggled="Toggled_SaveToggleData" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                    <toolkit:SettingsCard
                   l:Uids.Uid="SettingsPage_Scan_Engines"
                   HeaderIcon="{ui:FontIcon Glyph=&#xF0B9;}"
                   IsClickEnabled="True"
                   Click="Engines_Card_Click"
                   Margin="0,0,0,4">
                    </toolkit:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="Category_Engines" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                <toolkit:SettingsCard
                   VerticalAlignment="Top"
                   l:Uids.Uid="SettingsPage_Scan_Model"
                   HeaderIcon="{ui:FontIcon Glyph=&#xEC26;}"
                   IsClickEnabled="True"
                   Click="Model_Card_Click"
                   Margin="0,0,0,4">
                    <ToggleSwitch x:Name="ModelScanToggle"
                                  AutomationProperties.AutomationId="SettingsModelScanToggle"
                                  Tag="ModelScan"
                                  Toggled="Toggled_SaveToggleData" />
                </toolkit:SettingsCard>
                <toolkit:SettingsExpander
                           VerticalAlignment="Top"
                           l:Uids.Uid="SettingsPage_Scan_Local"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}"
                           x:Name="Scan_Local"
                           Margin="0,0,0,4">
                    <ToggleSwitch x:Name="LocalScanToggle" Tag="LocalScan" Toggled="Toggled_SaveToggleData" />
                    <toolkit:SettingsExpander.Items>
                        <!-- Keep the SettingsCard container required by the expander's item style.
                             Its template lets the InfoBar use the full row width. -->
                        <toolkit:SettingsCard IsClickEnabled="False" HorizontalContentAlignment="Stretch" Padding="0">
                            <toolkit:SettingsCard.Template>
                                <ControlTemplate TargetType="toolkit:SettingsCard">
                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                                </ControlTemplate>
                            </toolkit:SettingsCard.Template>
                            <InfoBar x:Name="LocalEngineSupportWarningBar"
                                     IsOpen="True" IsClosable="False" Severity="Warning" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_Local_DeepScan"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}">
                            <ToggleSwitch x:Name="DeepScanToggle" Tag="DeepScan" Toggled="Toggled_SaveToggleData"  />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_Local_ExtraData"
                           HeaderIcon="{ui:FontIcon Glyph=&#xF211;}">
                            <ToggleSwitch x:Name="ExtraDataToggle" Tag="ExtraData" Toggled="Toggled_SaveToggleData"  />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander
                           VerticalAlignment="Top"
                           l:Uids.Uid="SettingsPage_Scan_Cloud"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE753;}"
                           Margin="0,0,0,4">
                    <ToggleSwitch x:Name="CloudScanToggle" Tag="CloudScan" Toggled="Toggled_SaveToggleData"  />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard IsClickEnabled="False" HorizontalContentAlignment="Stretch" Padding="0">
                            <toolkit:SettingsCard.Template>
                                <ControlTemplate TargetType="toolkit:SettingsCard">
                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                                </ControlTemplate>
                            </toolkit:SettingsCard.Template>
                            <InfoBar x:Name="CloudScanHealthBar"
                                     Title="SevenEngine" IsOpen="True" IsClosable="False" Severity="Informational">
                                <InfoBar.ActionButton>
                                    <Button x:Name="CloudScanHealthRefreshButton"
                                            l:Uids.Uid="SettingsPage_Scan_Cloud_Health_Refresh"
                                            Click="CloudScanHealthRefreshButton_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_Cloud_ScanType"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
                            <ComboBox
                                x:Name="CloudScanModeComboBox"
                                SelectionChanged="CloudScanModeComboBox_SelectionChanged">
                                <ComboBoxItem
                                    x:Name="CloudScanModeAdaptive"
                                    Tag="Adaptive"
                                    l:Uids.Uid="SettingsPage_Scan_Cloud_ScanType_Adaptive" />
                                <ComboBoxItem
                                    x:Name="CloudScanModeQuick"
                                    Tag="Quick"
                                    l:Uids.Uid="SettingsPage_Scan_Cloud_ScanType_Quick" />
                                <ComboBoxItem
                                    x:Name="CloudScanModeFullUpload"
                                    Tag="FullUpload"
                                    l:Uids.Uid="SettingsPage_Scan_Cloud_ScanType_FullUpload" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Scan_Cloud_AboutEngine"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE946;}"
                           IsClickEnabled="True"
                           Click="CloudEngine_About_Card_Click" >
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                </StackPanel>
                <StackPanel x:Name="Category_Protection" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                <toolkit:SettingsExpander
                    x:Name="DriverProtectionCard"
                    VerticalAlignment="Top"
                    l:Uids.Uid="SettingsPage_Protection_Driver"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE83D;}"
                    Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="DriverProtectionStatusText"
                                   MinWidth="96"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <HyperlinkButton x:Name="DriverEnvironmentLink"
                                         l:Uids.Uid="SettingsPage_Protection_Driver_Environment"
                                         VerticalAlignment="Center"
                                         Click="DriverEnvironmentLink_Click"/>
                        <ToggleSwitch x:Name="DriverProtectionToggle"
                                      Tag="Driver"
                                      Toggled="DriverProtectionToggle_Toggled"/>
                    </StackPanel>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            x:Name="InjectionProtectionCard"
                            l:Uids.Uid="SettingsPage_Protection_Injection"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE8E5;}">
                            <ToggleSwitch x:Name="InjectionProtectionToggle"
                                          AutomationProperties.AutomationId="SettingsInjectionProtectionToggle"
                                          Tag="InjectionProtection"
                                          Toggled="InjectionProtectionToggle_Toggled"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander
                    x:Name="CompatProtectionCard"
                    VerticalAlignment="Top"
                    l:Uids.Uid="SettingsPage_Protection_CompatGroup"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7B8;}"
                    Margin="0,0,0,4">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            VerticalAlignment="Top"
                            l:Uids.Uid="SettingsPage_Protection_Process"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE9D5;}">
                            <ToggleSwitch x:Name="ProcessToggle" Tag="Process" Toggled="RunProtection" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            VerticalAlignment="Top"
                            l:Uids.Uid="SettingsPage_Protection_Files"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}">
                            <ToggleSwitch x:Name="FilesToggle" Tag="Files" Toggled="RunProtection"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            VerticalAlignment="Top"
                            l:Uids.Uid="SettingsPage_Protection_Boot"
                            HeaderIcon="{ui:FontIcon Glyph=&#xEDA2;}">
                            <ToggleSwitch x:Name="BootProtectionToggle"
                                          AutomationProperties.AutomationId="SettingsBootProtectionToggle"
                                          l:Uids.Uid="SettingsPage_Protection_Boot_Toggle"
                                          Tag="Boot"
                                          Toggled="BootProtectionToggle_Toggled"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            VerticalAlignment="Top"
                            l:Uids.Uid="SettingsPage_Protection_Registry"
                            x:Name="SettingsPage_Protection_Registry"
                            HeaderIcon="{ui:FontIcon Glyph=&#xEA37;}">
                            <ToggleSwitch x:Name="RegistryToggle" Tag="Registry" Toggled="RunProtection"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard
                    VerticalAlignment="Top"
                    l:Uids.Uid="SettingsPage_UsbAutoScan"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE88E;}"
                    Margin="0,0,0,4">
                    <ToggleSwitch x:Name="UsbAutoScanToggle" Toggled="Toggled_SaveToggleData" Tag="UsbAutoScan"/>
                </toolkit:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="Category_Features" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                <toolkit:SettingsExpander x:Name="Feature_ThreatNotificationMode"
                                           l:Uids.Uid="SettingsPage_Feature_ThreatNotificationMode"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}"
                                           Margin="0,0,0,4">
                    <ComboBox x:Name="ThreatNotificationModeComboBox"
                              AutomationProperties.AutomationId="ThreatNotificationModeComboBox"
                              SelectionChanged="ThreatNotificationModeComboBox_SelectionChanged">
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Feature_ThreatNotificationMode_Normal"
                                      Tag="Normal" />
                        <ComboBoxItem l:Uids.Uid="SettingsPage_Feature_ThreatNotificationMode_Compact"
                                      Tag="Compact" />
                    </ComboBox>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard l:Uids.Uid="SettingsPage_Feature_ThreatNotificationMode_OnlyWhenGaming"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xE7FC;}">
                            <ToggleSwitch x:Name="CompactNotificationWhenGamingToggle"
                                          AutomationProperties.AutomationId="CompactNotificationWhenGamingToggle"
                                          Tag="UseCompactThreatNotificationsWhenGaming"
                                          Toggled="CompactNotificationWhenGamingToggle_Toggled" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard l:Uids.Uid="SettingsPage_Feature_ThreatNotificationMode_GamePaths"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xE71D;}">
                            <Button x:Name="GamePathsViewButton"
                                    AutomationProperties.AutomationId="GamePathsViewButton"
                                    l:Uids.Uid="AllPage_OpenLink"
                                    Click="GamePathsViewButton_Click" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander x:Name="Feature_BrowserProtection"
                                           l:Uids.Uid="SettingsPage_Feature_BrowserProtection"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE774;}"
                                           Margin="0,0,0,4">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard l:Uids.Uid="SettingsPage_Feature_BrowserProtection_OpenFolder"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xE8DA;}">
                            <Button x:Name="OpenBrowserProtectionFolderButton"
                                    AutomationProperties.AutomationId="OpenBrowserProtectionFolderButton"
                                    l:Uids.Uid="AllPage_OpenLink"
                                    Click="OpenBrowserProtectionFolderButton_Click" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard
                                    l:Uids.Uid="SettingsPage_Protection_Boot_Save"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xECF0;}">
                    <Button x:Name="BootSaveButton"
                                            AutomationProperties.AutomationId="SettingsBootBackupButton"
                                            l:Uids.Uid="SettingsPage_Protection_Boot_Save_Button"
                                            Click="Boot_Save_Button_Click"/>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                                    l:Uids.Uid="SettingsPage_Protection_Boot_Open"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xEBC4;}">
                    <Button x:Name="BootRestoreButton"
                                            AutomationProperties.AutomationId="SettingsBootRestoreButton"
                                            l:Uids.Uid="SettingsPage_Protection_Boot_Open_Button"
                                            Click="Boot_Restore_Button_Click"/>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                                    l:Uids.Uid="SettingsPage_Feature_LegacyFilePicker"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}"
                                    Margin="0,0,0,4">
                    <ToggleSwitch x:Name="LegacyFilePickerToggle"
                                            AutomationProperties.AutomationId="LegacyFilePickerToggle"
                                            Tag="UseLegacyFilePicker"
                                            Toggled="Toggled_SaveToggleData" />
                </toolkit:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="Category_Quarantine" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                <toolkit:SettingsCard
                   VerticalAlignment="Top"
                   l:Uids.Uid="SettingsPage_Quarantine"
                   HeaderIcon="{ui:FontIcon Glyph=&#xE8B6;}"
                   IsClickEnabled="True"
                   Click="Quarantine_Card_Click"
                   Margin="0,0,0,4" />
                <toolkit:SettingsCard
                   VerticalAlignment="Top"
                   l:Uids.Uid="SettingsPage_Trust"
                   HeaderIcon="{ui:FontIcon Glyph=&#xE8E5;}"
                   IsClickEnabled="True"
                   Click="Trust_Card_Click"
                   Margin="0,0,0,4" />
                </StackPanel>
                <StackPanel x:Name="Category_General" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                <toolkit:SettingsCard 
                    l:Uids.Uid="SettingsPage_Other_Language"
                    HeaderIcon="{ui:FontIcon Glyph=&#xF2B7;}"
                    Margin="0,0,0,4">
                    <ComboBox x:Name="LanguageComboBox" 
                   SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Tag="en-US">English</ComboBoxItem>
                        <ComboBoxItem Tag="zh-HANS">简体中文</ComboBoxItem>
                        <ComboBoxItem Tag="zh-HANT">繁體中文</ComboBoxItem>
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Other_Tray"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE90E;}"
                           Margin="0,0,0,4">
                    <ToggleSwitch x:Name="TrayVisibleToggle" Tag="TrayVisibleToggle" Toggled="TrayVisibleToggle_Toggled" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Other_Startup"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE7E8;}"
                           Margin="0,0,0,4">
                    <ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggle_Toggled" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Other_ContextMenuScan"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}"
                           Margin="0,0,0,4">
                    <ToggleSwitch x:Name="ContextMenuScanToggle" Tag="ContextMenuScan" Toggled="ContextMenuScanToggle_Toggled" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Other_DisableVerify"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE72E;}"
                           Margin="0,0,0,4">
                    <ToggleSwitch x:Name="DisabledVerifyToggle" Tag="DisabledVerify" Toggled="DisabledVerifyToggle_Toggled" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                           l:Uids.Uid="SettingsPage_Other_RestartOOBE"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE7B3;}"
                           Margin="0,0,0,4">
                    <Button l:Uids.Uid="AllPage_OpenLink" Click="RestartOOBEButton_Click" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard 
                   l:Uids.Uid="SettingsPage_Other_CheckUpdate"
                   HeaderIcon="{ui:FontIcon Glyph=&#xE895;}"
                   Margin="0,0,0,4">
                    <Grid>
                        <Button l:Uids.Uid="SettingsPage_Other_CheckUpdate_Button" x:Name="UpdateButton" Click="UpdateButtonClick" Style="{ThemeResource AccentButtonStyle}" />
                        <ProgressRing x:Name="UpdateProgressRing" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
                    </Grid>
                </toolkit:SettingsCard>
                <toolkit:SettingsExpander
                           VerticalAlignment="Top"
                           l:Uids.Uid="SettingsPage_Other_Config"
                           HeaderIcon="{ui:FontIcon Glyph=&#xF259;}"
                           Margin="0,0,0,4">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                       l:Uids.Uid="SettingsPage_Other_Config_Location"
                       HeaderIcon="{ui:FontIcon Glyph=&#xE8DA;}">
                            <Button l:Uids.Uid="AllPage_OpenLink" x:Name="OpenConfigLocationButton" Click="OpenConfigLocationButton_Click"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                       l:Uids.Uid="SettingsPage_Other_Config_Reset"
                       HeaderIcon="{ui:FontIcon Glyph=&#xEBC4;}">
                            <Button l:Uids.Uid="AllPage_OpenLink" x:Name="ResetConfigButton" Click="ResetConfigButton_Click"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander
                           VerticalAlignment="Top"
                           l:Uids.Uid="SettingsPage_Other_About"
                           IsExpanded="True"
                           HeaderIcon="{ui:FontIcon Glyph=&#xE946;}"
                           Margin="0,0,0,4">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard l:Uids.Uid="SettingsPage_Other_About_Name" HeaderIcon="{ui:FontIcon Glyph=&#xE8AC;}">
                            <TextBlock x:Name="Settings_About_Name"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard l:Uids.Uid="SettingsPage_Other_About_Version" HeaderIcon="{ui:FontIcon Glyph=&#xE7B8;}">
                            <TextBlock x:Name="Settings_About_Version"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard l:Uids.Uid="SettingsPage_Other_About_Developer" HeaderIcon="{ui:FontIcon Glyph=&#xEC7A;}">
                            <TextBlock x:Name="Settings_About_Developer"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard l:Uids.Uid="SettingsPage_Other_About_Feedback" HeaderIcon="{ui:FontIcon Glyph=&#xED15;}">
                            <HyperlinkButton l:Uids.Uid="AllPage_OpenLink" x:Name="Settings_About_Feedback"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard l:Uids.Uid="SettingsPage_Other_About_Website" HeaderIcon="{ui:FontIcon Glyph=&#xE774;}">
                            <HyperlinkButton l:Uids.Uid="AllPage_OpenLink" x:Name="Settings_About_Website" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                </StackPanel>
                <TeachingTip
               x:Name="UpdateTeachingTip"
               l:Uids.Uid="SettingsPage_Other_CheckUpdate_UpdateTeachingTip"
               ActionButtonClick="UpdateTeachingTipClose"
               Target="{x:Bind UpdateButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
