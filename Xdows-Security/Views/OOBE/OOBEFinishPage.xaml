<?xml version="1.0" encoding="utf-8"?>
<local:OOBEStepPageBase
    x:Class="Xdows_Security.Views.OOBE.OOBEFinishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Xdows_Security.Views.OOBE"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48,0,48,0" Spacing="16" Width="560">
            <TextBlock x:Name="TitleText" l:Uids.Uid="OOBE_Finish_Title" Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center" />
            <StackPanel x:Name="ContentRoot" Spacing="12" HorizontalAlignment="Center">
                <TextBlock l:Uids.Uid="OOBE_Finish_Content" Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" />
                <Button x:Name="FinishButton" Click="FinishButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="LoadingRing" Width="16" Height="16" IsActive="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="FinishButtonText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:OOBEStepPageBase>
