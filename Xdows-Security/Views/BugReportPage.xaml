<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Xdows_Security.Views.BugReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">

    <Grid Margin="64,24,64,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Button x:Name="SettingsBtn"
                        AutomationProperties.AutomationId="BugReportSettingsButton"
                        Click="SettingsBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                        <TextBlock l:Uids.Uid="BugReportPage_SettingsButtonText"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ReconnectBtn"
                        AutomationProperties.AutomationId="BugReportReconnectButton"
                        Click="ReconnectBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        <TextBlock l:Uids.Uid="BugReportPage_ReconnectButtonText"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Padding="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ChatScroll"
                              AutomationProperties.AutomationId="BugReportMessageScroll"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessagesPanel"
                                Spacing="4"
                                Padding="0,0,8,0"/>
                </ScrollViewer>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox"
                             AutomationProperties.AutomationId="BugReportMessageInput"
                             Grid.Column="0"
                             l:Uids.Uid="BugReportPage_Input"
                             MinHeight="32"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             KeyDown="InputBox_KeyDown"/>

                    <Button x:Name="SendBtn"
                            AutomationProperties.AutomationId="BugReportSendButton"
                            Grid.Column="1"
                            MinHeight="32"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SendBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE724;" FontSize="16"/>
                            <TextBlock l:Uids.Uid="BugReportPage_SendButtonText"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0"
                      Margin="0,0,8,0"
                      Glyph="&#xE946;"
                      FontSize="16"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="StatusTxt"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Page>
