<UserControl
    x:Class="Xdows_Security.InfoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border BorderThickness="1" 
            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}" 
            Padding="16">
        <StackPanel Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                    <FontIcon Glyph="{x:Bind Icon, Mode=OneWay}"
                              FontSize="20"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ContentPresenter Grid.Column="1"
                                  Content="{x:Bind HeaderActions, Mode=OneWay}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
            </Grid>

            <ContentPresenter Content="{x:Bind CardContent, Mode=OneWay}"/>
        </StackPanel>
    </Border>
</UserControl>