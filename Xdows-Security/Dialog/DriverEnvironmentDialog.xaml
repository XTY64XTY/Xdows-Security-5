<ContentDialog
    x:Class="Xdows_Security.DriverEnvironmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <Grid MinWidth="540" MaxWidth="760" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText"
                   TextWrapping="WrapWholeWords"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="480">
            <StackPanel x:Name="GroupsPanel" Spacing="8"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="ResultInfoBar"
                     IsOpen="False"
                     IsClosable="True"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock x:Name="RefreshText" Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
