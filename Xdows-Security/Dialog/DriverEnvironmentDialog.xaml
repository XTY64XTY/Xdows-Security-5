<ContentDialog
    x:Class="Xdows_Security.DriverEnvironmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:protection="using:Protection"
    DefaultButton="Close"
    CornerRadius="{ThemeResource ControlCornerRadius}">

    <Grid MinWidth="520" MaxWidth="720" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText"
                   TextWrapping="WrapWholeWords"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <ListView x:Name="ChecksListView"
                  Grid.Row="1"
                  MaxHeight="420"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="protection:DriverEnvironmentCheckItem">
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Detail}"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind StatusText}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                MinWidth="132"
                                VerticalAlignment="Center"
                                Content="{x:Bind RepairAction}"
                                IsEnabled="{x:Bind CanRepair}"
                                DataContext="{Binding}"
                                Click="RepairButton_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="ResultInfoBar"
                     IsOpen="False"
                     IsClosable="True"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
