<ContentDialog x:Class="Xdows_Security.TrustDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:l="using:WinUI3Localizer"
               DefaultButton="Primary"
               CornerRadius="{ThemeResource ControlCornerRadius}"
               l:Uids.Uid="TrustDialog_Dialog"
               PrimaryButtonClick="OnPrimaryButtonClick"
               SecondaryButtonClick="OnSecondaryButtonClick"
               xmlns:local="using:TrustQuarantine">

    <Grid>
        <ListView x:Name="TrustListView" 
                  SelectionMode="Multiple">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem l:Uids.Uid="TrustDialog_DeleteMenuItem" Click="DeleteMenuItem_Click"/>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem l:Uids.Uid="TrustDialog_AddMenuItem"    Click="AddMenuItem_Click"/>
                    <MenuFlyoutItem l:Uids.Uid="TrustDialog_ClearMenuItem"  Click="ClearMenuItem_Click"/>
                </MenuFlyout>
            </ListView.ContextFlyout>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TrustItemModel">
                    <StackPanel Spacing="2" Padding="8,6"> 
                        <TextBlock Text="{x:Bind SourcePath}" TextWrapping="WrapWholeWords"/>
                        <TextBlock Text="{x:Bind Hash}" 
                                   FontSize="10" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   IsTextSelectionEnabled="True" 
                                   TextWrapping="NoWrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyStatePanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Margin="0,32,0,32">
            <FontIcon Glyph="&#xE8D7;" FontSize="36"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyStateText"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</ContentDialog>
