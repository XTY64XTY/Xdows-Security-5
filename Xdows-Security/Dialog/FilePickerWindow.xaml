<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Xdows_Security.FilePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:Xdows_Security"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Xdows_Security.Services"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <local:TitleBarMenu OwnerWindow="{x:Bind Mode=OneTime}" />
            <TitleBar x:Name="PickerTitleBar"
                      Height="48"
                      IsBackButtonVisible="False"
                      IsPaneToggleButtonVisible="False" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Width="36"
                    Height="32"
                    Padding="0">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton"
                    Grid.Column="1"
                    Click="ForwardButton_Click"
                    Width="36"
                    Height="32"
                    Padding="0">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button x:Name="UpButton"
                    Grid.Column="2"
                    Click="UpButton_Click"
                    Width="36"
                    Height="32"
                    Padding="0">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
            <Grid Grid.Column="3" Margin="4,0,0,0" Height="32" VerticalAlignment="Center">
                <Border x:Name="BreadcrumbHost"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="4,0"
                        Tapped="AddressBar_Tapped">
                    <ScrollViewer x:Name="BreadcrumbScroll"
                                  HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Stretch">
                        <StackPanel x:Name="BreadcrumbPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center" />
                    </ScrollViewer>
                </Border>
                <TextBox x:Name="PathEditBox"
                         Visibility="Collapsed"
                         FontSize="13"
                         Padding="8,6,8,6"
                         VerticalContentAlignment="Center"
                         KeyDown="PathEditBox_KeyDown"
                         LostFocus="PathEditBox_LostFocus" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="12,0,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock l:Uids.Uid="FilePicker_Nav_QuickAccess"
                           Opacity="0.6"
                           Margin="10,0,0,0" />
                <ListView x:Name="QuickAccessList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="LocationList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:FilePickerLocation">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                <TextBlock Text="{x:Bind Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="2"
                           l:Uids.Uid="FilePicker_Nav_ThisPc"
                           Opacity="0.6"
                           Margin="10,8,0,0" />
                <ListView x:Name="DriveList"
                          Grid.Row="3"
                          SelectionMode="Single"
                          SelectionChanged="LocationList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:FilePickerLocation">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="ListHost" Grid.Column="1" RowSpacing="2" MinHeight="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12,0,0,0"
                        Height="28"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock l:Uids.Uid="FilePicker_Column_Name" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" l:Uids.Uid="FilePicker_Column_DateModified" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" l:Uids.Uid="FilePicker_Column_Type" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" l:Uids.Uid="FilePicker_Column_Size" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ListView x:Name="EntryList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="EntryList_SelectionChanged"
                          DoubleTapped="EntryList_DoubleTapped"
                          KeyDown="EntryList_KeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:FilePickerEntry">
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DateText}"
                                           Opacity="0.8"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind TypeText}"
                                           Opacity="0.8"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind SizeText}"
                                           Opacity="0.8"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyText"
                           Grid.Row="1"
                           l:Uids.Uid="FilePicker_EmptyFolder"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           Visibility="Collapsed" />

                <StackPanel x:Name="LoadingPanel"
                            Grid.Row="1"
                            Spacing="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressRing Width="48" Height="48" IsActive="True" HorizontalAlignment="Center" />
                    <TextBlock l:Uids.Uid="FilePicker_Loading" HorizontalAlignment="Center" FontSize="14" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="12,8,12,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="FileNamePanel" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock l:Uids.Uid="FilePicker_FileName" VerticalAlignment="Center" />
                        <TextBox x:Name="FileNameBox" Grid.Column="1" KeyDown="FileNameBox_KeyDown" />
                    </Grid>

                    <StackPanel x:Name="FileTypePanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock l:Uids.Uid="FilePicker_FileType" VerticalAlignment="Center" />
                        <ComboBox x:Name="FileTypeCombo" MinWidth="176" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="NewFolderButton"
                            l:Uids.Uid="FilePicker_NewFolder"
                            Click="NewFolderButton_Click" />
                    <Button x:Name="AcceptButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AcceptButton_Click" />
                    <Button x:Name="CancelButton" Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
