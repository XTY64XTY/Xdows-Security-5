<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Xdows_Security</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64;AnyCPU</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<PlatformTarget>x64</PlatformTarget>
		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>
		<SelfContained>true</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>
		<WindowsPackageType>None</WindowsPackageType>
		<LangVersion>preview</LangVersion>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<PublishAot>True</PublishAot>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<PublishTrimmed>true</PublishTrimmed>
		<EnableMsixTooling>true</EnableMsixTooling>
		<IsAotCompatible>true</IsAotCompatible>
		<CsWinRTAotOptimizerEnable>true</CsWinRTAotOptimizerEnable>
		<TrimMode>partial</TrimMode>
		<InvariantGlobalization>false</InvariantGlobalization>
		<StackTraceSupport>false</StackTraceSupport>
		<UseWindowsThreadPool>true</UseWindowsThreadPool>
		<IlcOptimizationPreference>Speed</IlcOptimizationPreference>
		<IlcInstructionSet>x86-64-v2</IlcInstructionSet>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<XdowsCodeRoot>$(MSBuildProjectDirectory)\..\..</XdowsCodeRoot>
		<XdowsNoDriverBuild Condition="'$(LaunchProfileName)' == 'Xdows-Security (Unpackaged - No Driver Build)' Or '$(ActiveDebugProfile)' == 'Xdows-Security (Unpackaged - No Driver Build)'">true</XdowsNoDriverBuild>
		<XdowsBuildDriver Condition="'$(XdowsNoDriverBuild)' == 'true'">false</XdowsBuildDriver>
		<XdowsNativeConfiguration Condition="'$(XdowsNoDriverBuild)' == 'true'">Debug</XdowsNativeConfiguration>
		<XdowsDriverConfiguration Condition="'$(XdowsNoDriverBuild)' == 'true'">Debug</XdowsDriverConfiguration>
		<XdowsRuntimeProjectConfiguration Condition="'$(XdowsNoDriverBuild)' == 'true'">Debug</XdowsRuntimeProjectConfiguration>
		<XdowsBuildDriver Condition="'$(XdowsBuildDriver)' == ''">true</XdowsBuildDriver>
		<XdowsNativeConfiguration Condition="'$(XdowsNativeConfiguration)' == ''">$(Configuration)</XdowsNativeConfiguration>
		<XdowsDriverConfiguration Condition="'$(XdowsDriverConfiguration)' == ''">$(Configuration)</XdowsDriverConfiguration>
		<XdowsRuntimeProjectConfiguration Condition="'$(XdowsRuntimeProjectConfiguration)' == ''">$(Configuration)</XdowsRuntimeProjectConfiguration>
		<XdowsModelInvokerRoot>$(XdowsCodeRoot)\Xdows-Model\Xdows-Model-Invoker</XdowsModelInvokerRoot>
		<XdowsModelNativeProject>$(XdowsCodeRoot)\Xdows-Model\Xdows-Model-Native\Xdows-Model-Native.vcxproj</XdowsModelNativeProject>
		<XdowsModelNativeProjectOutput>$(XdowsCodeRoot)\Xdows-Model\Xdows-Model-Native\$(Platform)\$(XdowsNativeConfiguration)</XdowsModelNativeProjectOutput>
		<XdowsModelNativeSolutionOutput>$(XdowsCodeRoot)\Xdows-Model\$(Platform)\$(XdowsNativeConfiguration)</XdowsModelNativeSolutionOutput>
		<XdowsModelNativeOutput Condition="Exists('$(XdowsModelNativeProjectOutput)\Xdows-Model-Native.dll')">$(XdowsModelNativeProjectOutput)</XdowsModelNativeOutput>
		<XdowsModelNativeOutput Condition="'$(XdowsModelNativeOutput)' == '' AND Exists('$(XdowsModelNativeSolutionOutput)\Xdows-Model-Native.dll')">$(XdowsModelNativeSolutionOutput)</XdowsModelNativeOutput>
		<XdowsModelNativeOutput Condition="'$(XdowsModelNativeOutput)' == ''">$(XdowsModelNativeProjectOutput)</XdowsModelNativeOutput>
		<XdowsDriverProject>$(XdowsCodeRoot)\Xdows-Security-Driver\Xdows-Security-Driver\Xdows-Security-Driver.vcxproj</XdowsDriverProject>
		<XdowsDriverProjectPackageOutput>$(XdowsCodeRoot)\Xdows-Security-Driver\Xdows-Security-Driver\$(Platform)\$(XdowsDriverConfiguration)\Xdows-Security-Driver</XdowsDriverProjectPackageOutput>
		<XdowsDriverPackageOutput>$(XdowsDriverProjectPackageOutput)</XdowsDriverPackageOutput>
	</PropertyGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="Xdows-Security" />
		<TrimmerRootAssembly Include="WinUI3Localizer" />
		<TrimmerRootAssembly Include="WinUIEx" />
		<TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
	</ItemGroup>

	<ItemGroup>
		<PRIResource Remove="Strings\**\*.resw" />
		<Content Include="Strings\**\*.resw">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="logo.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
		<PackageReference Include="CommunityToolkit.WinUI.UI.Controls.Markdown" Version="7.1.2" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.9" />
		<PackageReference Include="WinUI3Localizer" Version="2.3.0" />
		<PackageReference Include="WinUIEx" Version="2.9.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Helper\Helper.csproj" />
		<ProjectReference Include="..\Protection\Protection.csproj" />
		<ProjectReference Include="..\TrustQuarantine\TrustQuarantine.csproj" />
	</ItemGroup>

	<PropertyGroup Label="Globals">
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<ItemGroup>
		<PRIResource Remove="Resources\**" />
	</ItemGroup>
	<ItemGroup>
	  <PRIResource Remove="Strings\zh-HANT\Resources.resw" />
	</ItemGroup>
	<ItemGroup>
	  <Page Update="Style\InfoCard.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>
	<ItemGroup>
	  <Page Update="Style\CopyButton.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Dialog\" />
	</ItemGroup>

	<Target Name="BuildXdowsNativeAndDriverProjects" BeforeTargets="CollectXdowsDriverAndModelAssets" Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'ARM64'">
		<MSBuild Projects="$(XdowsModelNativeProject)" Targets="Build" Properties="Configuration=$(XdowsNativeConfiguration);Platform=$(Platform);WindowsTargetPlatformVersion=$(WindowsTargetPlatformVersion)" Condition="Exists('$(XdowsModelNativeProject)') AND '$(WindowsTargetPlatformVersion)' != ''" />
		<MSBuild Projects="$(XdowsModelNativeProject)" Targets="Build" Properties="Configuration=$(XdowsNativeConfiguration);Platform=$(Platform)" Condition="Exists('$(XdowsModelNativeProject)') AND '$(WindowsTargetPlatformVersion)' == ''" />
		<MSBuild Projects="$(XdowsDriverProject)" Targets="Build" Properties="Configuration=$(XdowsDriverConfiguration);Platform=$(Platform);WindowsTargetPlatformVersion=$(WindowsTargetPlatformVersion);SignMode=$(SignMode)" Condition="'$(XdowsBuildDriver)' == 'true' AND Exists('$(XdowsDriverProject)') AND '$(WindowsTargetPlatformVersion)' != ''" />
		<MSBuild Projects="$(XdowsDriverProject)" Targets="Build" Properties="Configuration=$(XdowsDriverConfiguration);Platform=$(Platform);SignMode=$(SignMode)" Condition="'$(XdowsBuildDriver)' == 'true' AND Exists('$(XdowsDriverProject)') AND '$(WindowsTargetPlatformVersion)' == ''" />
	</Target>

	<Target Name="BuildXdowsRuntimeProjectReferences" BeforeTargets="ResolveReferences" Condition="'$(RuntimeIdentifier)' != '' AND '$(DesignTimeBuild)' != 'true'">
		<ItemGroup>
			<XdowsRuntimeProjectReference Include="..\Helper\Helper.csproj" />
			<XdowsRuntimeProjectReference Include="..\Protection\Protection.csproj" />
			<XdowsRuntimeProjectReference Include="..\TrustQuarantine\TrustQuarantine.csproj" />
		</ItemGroup>
		<MSBuild Projects="@(XdowsRuntimeProjectReference)" Targets="Restore" Properties="Configuration=$(XdowsRuntimeProjectConfiguration);Platform=AnyCPU;RuntimeIdentifier=$(RuntimeIdentifier)" BuildInParallel="false" />
		<MSBuild Projects="@(XdowsRuntimeProjectReference)" Targets="Build" Properties="Configuration=$(XdowsRuntimeProjectConfiguration);Platform=AnyCPU;RuntimeIdentifier=$(RuntimeIdentifier)" BuildInParallel="false" />
	</Target>

	<Target Name="CollectXdowsDriverAndModelAssets" AfterTargets="Build" Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'ARM64'">
		<ItemGroup>
			<XdowsModelFiles Include="$(XdowsModelInvokerRoot)\Xdows-Model.onnx" />
			<XdowsModelFiles Include="$(XdowsModelInvokerRoot)\Xdows-Model-Flash.onnx" />
			<XdowsModelFiles Include="$(XdowsModelInvokerRoot)\Xdows-Model-Pro.onnx" />
			<XdowsNativeFiles Include="$(XdowsModelNativeOutput)\Xdows-Model-Native.dll" />
			<XdowsNativeFiles Include="$(XdowsModelNativeOutput)\onnxruntime.dll" />
			<XdowsNativeFiles Include="$(XdowsModelNativeOutput)\onnxruntime_providers_shared.dll" />
			<XdowsDriverFiles Include="$(XdowsDriverPackageOutput)\**\*" Condition="Exists('$(XdowsDriverPackageOutput)')" />
		</ItemGroup>

		<Error Condition="!Exists('$(XdowsModelNativeOutput)\Xdows-Model-Native.dll')" Text="Xdows-Model-Native.dll was not found. Build Xdows-Security.slnx with Visual Studio/MSBuild for $(Configuration)|$(Platform)." />
		<Error Condition="!Exists('$(XdowsModelNativeOutput)\onnxruntime.dll')" Text="onnxruntime.dll was not found in $(XdowsModelNativeOutput)." />
		<Error Condition="!Exists('$(XdowsModelNativeOutput)\onnxruntime_providers_shared.dll')" Text="onnxruntime_providers_shared.dll was not found in $(XdowsModelNativeOutput)." />
		<Error Condition="'$(XdowsBuildDriver)' == 'true' AND !Exists('$(XdowsDriverPackageOutput)\Xdows-Security-Driver.inf')" Text="Driver INF was not found in $(XdowsDriverPackageOutput). Build Xdows-Security.slnx with Visual Studio/MSBuild for $(Configuration)|$(Platform)." />
		<Error Condition="'$(XdowsBuildDriver)' == 'true' AND !Exists('$(XdowsDriverPackageOutput)\Xdows-Security-Driver.sys')" Text="Driver SYS was not found in $(XdowsDriverPackageOutput)." />
		<Error Condition="'$(XdowsBuildDriver)' == 'true' AND !Exists('$(XdowsDriverPackageOutput)\xdows-security-driver.cat') AND !Exists('$(XdowsDriverPackageOutput)\Xdows-Security-Driver.cat')" Text="Driver CAT was not found in $(XdowsDriverPackageOutput)." />

		<Copy SourceFiles="@(XdowsModelFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(XdowsNativeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(XdowsDriverFiles)" DestinationFiles="@(XdowsDriverFiles->'$(OutDir)Driver\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(XdowsDriverFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="VerifyPackagedXdowsDriver" AfterTargets="CollectXdowsDriverAndModelAssets"
		Condition="'$(XdowsBuildDriver)' == 'true' AND Exists('$(XdowsDriverPackageOutput)\Xdows-Security-Driver.sys') AND Exists('$(OutDir)Driver\Xdows-Security-Driver.sys')">
		<GetFileHash Files="$(XdowsDriverPackageOutput)\Xdows-Security-Driver.sys">
			<Output TaskParameter="Items" ItemName="XdowsSourceDriverHash" />
		</GetFileHash>
		<GetFileHash Files="$(OutDir)Driver\Xdows-Security-Driver.sys">
			<Output TaskParameter="Items" ItemName="XdowsPackagedDriverHash" />
		</GetFileHash>
		<PropertyGroup>
			<XdowsSourceDriverHashValue>%(XdowsSourceDriverHash.FileHash)</XdowsSourceDriverHashValue>
			<XdowsPackagedDriverHashValue>%(XdowsPackagedDriverHash.FileHash)</XdowsPackagedDriverHashValue>
		</PropertyGroup>
		<Error Condition="'$(XdowsSourceDriverHashValue)' != '$(XdowsPackagedDriverHashValue)'"
			Text="Packaged Xdows Security driver hash does not match the current driver build output." />
	</Target>

	<Target Name="AddXdowsDriverAndModelAssetsToPublish" BeforeTargets="ComputeFilesToPublish" Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'ARM64'">
		<ItemGroup>
			<XdowsPublishNativeFiles Include="$(XdowsModelNativeOutput)\Xdows-Model-Native.dll" />
			<XdowsPublishDriverFiles Include="$(XdowsDriverPackageOutput)\**\*" Condition="Exists('$(XdowsDriverPackageOutput)')" />
			<ResolvedFileToPublish Include="@(XdowsPublishNativeFiles)" Condition="Exists('%(XdowsPublishNativeFiles.Identity)')">
				<RelativePath>%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Include="@(XdowsPublishDriverFiles)" Condition="Exists('%(XdowsPublishDriverFiles.Identity)')">
				<RelativePath>Driver\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Include="@(XdowsPublishDriverFiles)" Condition="Exists('%(XdowsPublishDriverFiles.Identity)')">
				<RelativePath>%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<Target Name="PublishXdowsDriverAndModelAssets" AfterTargets="Publish" Condition="'$(PublishDir)' != '' AND ('$(Platform)' == 'x64' OR '$(Platform)' == 'ARM64')">
		<ItemGroup>
			<XdowsPublishModelFiles Include="$(XdowsModelInvokerRoot)\Xdows-Model.onnx" />
			<XdowsPublishModelFiles Include="$(XdowsModelInvokerRoot)\Xdows-Model-Flash.onnx" />
			<XdowsPublishModelFiles Include="$(XdowsModelInvokerRoot)\Xdows-Model-Pro.onnx" />
			<XdowsPublishNativeFiles Include="$(XdowsModelNativeOutput)\Xdows-Model-Native.dll" />
			<XdowsPublishNativeFiles Include="$(XdowsModelNativeOutput)\onnxruntime.dll" />
			<XdowsPublishNativeFiles Include="$(XdowsModelNativeOutput)\onnxruntime_providers_shared.dll" />
			<XdowsPublishDriverFiles Include="$(XdowsDriverPackageOutput)\**\*" Condition="Exists('$(XdowsDriverPackageOutput)')" />
		</ItemGroup>

		<Copy SourceFiles="@(XdowsPublishModelFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(XdowsPublishModelFiles.Identity)')" />
		<Copy SourceFiles="@(XdowsPublishNativeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(XdowsPublishNativeFiles.Identity)')" />
		<Copy SourceFiles="@(XdowsPublishDriverFiles)" DestinationFiles="@(XdowsPublishDriverFiles->'$(PublishDir)Driver\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(XdowsPublishDriverFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
	</Target>
</Project>
