<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Xdows_Security</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64;AnyCPU</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<PlatformTarget>x64</PlatformTarget>
		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>
		<SelfContained>true</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>
		<WindowsPackageType>None</WindowsPackageType>
		<StartupHookSupport>true</StartupHookSupport>
		<LangVersion>preview</LangVersion>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<PublishAot>True</PublishAot>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<PublishTrimmed>true</PublishTrimmed>
		<EnableMsixTooling>true</EnableMsixTooling>
		<IsAotCompatible>true</IsAotCompatible>
		<CsWinRTAotOptimizerEnable>true</CsWinRTAotOptimizerEnable>
		<TrimMode>partial</TrimMode>
		<InvariantGlobalization>false</InvariantGlobalization>
		<StackTraceSupport>false</StackTraceSupport>
		<UseWindowsThreadPool>true</UseWindowsThreadPool>
		<IlcOptimizationPreference>Speed</IlcOptimizationPreference>
		<IlcInstructionSet>x86-64-v2</IlcInstructionSet>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CodeRoot>$(MSBuildProjectDirectory)\..\..</CodeRoot>
		<BuildDriver Condition="'$(BuildDriver)' == ''">true</BuildDriver>
		<NativeConfiguration Condition="'$(NativeConfiguration)' == ''">$(Configuration)</NativeConfiguration>
		<DriverConfiguration Condition="'$(DriverConfiguration)' == ''">$(Configuration)</DriverConfiguration>
		<RuntimeProjectConfiguration Condition="'$(RuntimeProjectConfiguration)' == ''">$(Configuration)</RuntimeProjectConfiguration>
		<XdowsModelInvokerRoot>$(CodeRoot)\Xdows-Model\Xdows-Model-Invoker</XdowsModelInvokerRoot>
		<XdowsModelNativeProject>$(CodeRoot)\Xdows-Model\Xdows-Model-Native\Xdows-Model-Native.vcxproj</XdowsModelNativeProject>
		<XdowsModelNativeOutput>$(MSBuildProjectDirectory)\obj\XdowsModelNative\$(Platform)\$(NativeConfiguration)</XdowsModelNativeOutput>
		<XdowsModelNativeIntermediate>$(MSBuildProjectDirectory)\obj\XdowsModelNative\$(Platform)\$(NativeConfiguration)\Intermediate</XdowsModelNativeIntermediate>
		<DriverProject>$(CodeRoot)\Xdows-Security-Driver\Xdows-Security-Driver\Xdows-Security-Driver.vcxproj</DriverProject>
		<DriverProjectOutput>$(CodeRoot)\Xdows-Security-Driver\Xdows-Security-Driver\$(Platform)\$(DriverConfiguration)\</DriverProjectOutput>
		<DriverProjectPackageOutput>$(DriverProjectOutput)Xdows-Security-Driver</DriverProjectPackageOutput>
		<DriverPackageOutput>$(DriverProjectPackageOutput)</DriverPackageOutput>
		<BootFilterProject>$(CodeRoot)\Xdows-Security-Driver\Xdows-Security-BootFilter\Xdows-Security-BootFilter.vcxproj</BootFilterProject>
		<BootFilterProjectOutput>$(CodeRoot)\Xdows-Security-Driver\Xdows-Security-BootFilter\$(Platform)\$(DriverConfiguration)\</BootFilterProjectOutput>
		<BootFilterIntermediate>$(MSBuildProjectDirectory)\obj\BootFilter\$(Platform)\$(DriverConfiguration)\Intermediate\</BootFilterIntermediate>
		<BootFilterPackageOutput>$(BootFilterProjectOutput)Xdows-Security-BootFilter</BootFilterPackageOutput>
	</PropertyGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="Xdows-Security" />
		<TrimmerRootAssembly Include="WinUI3Localizer" />
		<TrimmerRootAssembly Include="WinUIEx" />
		<TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
	</ItemGroup>

	<ItemGroup>
		<PRIResource Remove="Strings\**\*.resw" />
		<Content Include="Strings\**\*.resw">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="logo.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- 声明式行为规则配置：随程序输出，供 DriverBehaviorRuleCatalog 在附加驱动后下发。 -->
	<ItemGroup>
		<Content Include="Config\BehaviorRules.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Noto Sans / Noto Sans SC（SIL Open Font License 1.1）：内置默认字体及其许可证全文。 -->
	<ItemGroup>
		<Content Include="Assets\Fonts\NotoSans-Variable.ttf">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\Fonts\NotoSansSC-Variable.ttf">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\Fonts\NotoSans-OFL.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\Fonts\NotoSansSC-OFL.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<PRIResource Include="Assets\Fonts\NotoSans-Variable.ttf" />
		<PRIResource Include="Assets\Fonts\NotoSansSC-Variable.ttf" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\BrowserProtection\**\*">
			<Link>BrowserProtection\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="Markdig" Version="1.4.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.12" />
		<PackageReference Include="WinUI3Localizer" Version="2.3.0" />
		<PackageReference Include="WinUIEx" Version="2.9.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Helper\Helper.csproj" />
		<ProjectReference Include="..\Protection\Protection.csproj" />
		<ProjectReference Include="..\TrustQuarantine\TrustQuarantine.csproj" />
	</ItemGroup>

	<PropertyGroup Label="Globals">
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyVersion>5.0.2.0</AssemblyVersion>
		<FileVersion>5.0.2.0</FileVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<BuildDriver>false</BuildDriver>
	</PropertyGroup>
	<ItemGroup>
		<PRIResource Remove="Resources\**" />
	</ItemGroup>
	<ItemGroup>
	  <PRIResource Remove="Strings\zh-HANT\Resources.resw" />
	</ItemGroup>
	<ItemGroup>
	  <Page Update="Style\InfoCard.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>
	<ItemGroup>
	  <Page Update="Style\CopyButton.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Dialog\" />
	</ItemGroup>

	<Target Name="BuildNativeAndDriverProjects" BeforeTargets="CollectDriverAndModelAssets" Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'ARM64'">
		<MSBuild Projects="$(XdowsModelNativeProject)" Targets="Build" Properties="Configuration=$(NativeConfiguration);Platform=$(Platform);OutDir=$(XdowsModelNativeOutput)\;IntDir=$(XdowsModelNativeIntermediate)\;WindowsTargetPlatformVersion=$(WindowsTargetPlatformVersion)" Condition="Exists('$(XdowsModelNativeProject)') AND '$(WindowsTargetPlatformVersion)' != ''" />
		<MSBuild Projects="$(XdowsModelNativeProject)" Targets="Build" Properties="Configuration=$(NativeConfiguration);Platform=$(Platform);OutDir=$(XdowsModelNativeOutput)\;IntDir=$(XdowsModelNativeIntermediate)\" Condition="Exists('$(XdowsModelNativeProject)') AND '$(WindowsTargetPlatformVersion)' == ''" />
		<MSBuild Projects="$(DriverProject)" Targets="Build" Properties="Configuration=$(DriverConfiguration);Platform=$(Platform);OutDir=$(DriverProjectOutput);WindowsTargetPlatformVersion=$(WindowsTargetPlatformVersion);SignMode=$(SignMode)" Condition="'$(BuildDriver)' == 'true' AND Exists('$(DriverProject)') AND '$(WindowsTargetPlatformVersion)' != ''" />
		<MSBuild Projects="$(DriverProject)" Targets="Build" Properties="Configuration=$(DriverConfiguration);Platform=$(Platform);OutDir=$(DriverProjectOutput);SignMode=$(SignMode)" Condition="'$(BuildDriver)' == 'true' AND Exists('$(DriverProject)') AND '$(WindowsTargetPlatformVersion)' == ''" />
		<MSBuild Projects="$(BootFilterProject)" Targets="Build" Properties="Configuration=$(DriverConfiguration);Platform=$(Platform);OutDir=$(BootFilterProjectOutput);IntDir=$(BootFilterIntermediate);WindowsTargetPlatformVersion=$(WindowsTargetPlatformVersion);SignMode=$(SignMode)" Condition="'$(BuildDriver)' == 'true' AND Exists('$(BootFilterProject)') AND '$(WindowsTargetPlatformVersion)' != ''" />
		<MSBuild Projects="$(BootFilterProject)" Targets="Build" Properties="Configuration=$(DriverConfiguration);Platform=$(Platform);OutDir=$(BootFilterProjectOutput);IntDir=$(BootFilterIntermediate);SignMode=$(SignMode)" Condition="'$(BuildDriver)' == 'true' AND Exists('$(BootFilterProject)') AND '$(WindowsTargetPlatformVersion)' == ''" />
	</Target>

	<Target Name="BuildRuntimeProjectReferences" BeforeTargets="ResolveReferences" Condition="'$(RuntimeIdentifier)' != '' AND '$(DesignTimeBuild)' != 'true'">
		<ItemGroup>
			<RuntimeProjectReference Include="..\Helper\Helper.csproj" />
			<RuntimeProjectReference Include="..\Protection\Protection.csproj" />
			<RuntimeProjectReference Include="..\TrustQuarantine\TrustQuarantine.csproj" />
		</ItemGroup>
		<MSBuild Projects="@(RuntimeProjectReference)" Targets="Restore" Properties="Configuration=$(RuntimeProjectConfiguration);Platform=AnyCPU;RuntimeIdentifier=$(RuntimeIdentifier)" BuildInParallel="false" />
		<MSBuild Projects="@(RuntimeProjectReference)" Targets="Build" Properties="Configuration=$(RuntimeProjectConfiguration);Platform=AnyCPU;RuntimeIdentifier=$(RuntimeIdentifier)" BuildInParallel="false" />
	</Target>

	<Target Name="CollectDriverAndModelAssets" AfterTargets="Build" Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'ARM64'">
		<ItemGroup>
			<XdowsModelFiles Include="$(XdowsModelInvokerRoot)\Models\*.onnx" />
			<XdowsModelFiles Include="$(XdowsModelInvokerRoot)\Models\*.json" />
			<NativeFiles Include="$(XdowsModelNativeOutput)\Xdows-Model-Native.dll" />
			<NativeFiles Include="$(XdowsModelNativeOutput)\onnxruntime.dll" />
			<NativeFiles Include="$(XdowsModelNativeOutput)\onnxruntime_providers_shared.dll" />
			<DriverFiles Include="$(DriverPackageOutput)\**\*" Condition="Exists('$(DriverPackageOutput)')" />
			<BootFilterFiles Include="$(BootFilterPackageOutput)\**\*" Condition="Exists('$(BootFilterPackageOutput)')" />
		</ItemGroup>

		<Error Condition="!Exists('$(XdowsModelNativeOutput)\Xdows-Model-Native.dll')" Text="Xdows-Model-Native.dll was not found. Build Xdows-Security.slnx with Visual Studio/MSBuild for $(Configuration)|$(Platform)." />
		<Error Condition="!Exists('$(XdowsModelNativeOutput)\onnxruntime.dll')" Text="onnxruntime.dll was not found in $(XdowsModelNativeOutput)." />
		<Error Condition="!Exists('$(XdowsModelNativeOutput)\onnxruntime_providers_shared.dll')" Text="onnxruntime_providers_shared.dll was not found in $(XdowsModelNativeOutput)." />
		<Error Condition="'$(BuildDriver)' == 'true' AND !Exists('$(DriverPackageOutput)\Xdows-Security-Driver.inf')" Text="Driver INF was not found in $(DriverPackageOutput). Build Xdows-Security.slnx with Visual Studio/MSBuild for $(Configuration)|$(Platform)." />
		<Error Condition="'$(BuildDriver)' == 'true' AND !Exists('$(DriverPackageOutput)\Xdows-Security-Driver.sys')" Text="Driver SYS was not found in $(DriverPackageOutput)." />
		<Error Condition="'$(BuildDriver)' == 'true' AND !Exists('$(DriverPackageOutput)\xdows-security-driver.cat') AND !Exists('$(DriverPackageOutput)\Xdows-Security-Driver.cat')" Text="Driver CAT was not found in $(DriverPackageOutput)." />
		<Error Condition="'$(BuildDriver)' == 'true' AND !Exists('$(BootFilterPackageOutput)\Xdows-Security-BootFilter.inf')" Text="Boot filter INF was not found in $(BootFilterPackageOutput)." />
		<Error Condition="'$(BuildDriver)' == 'true' AND !Exists('$(BootFilterPackageOutput)\Xdows-Security-BootFilter.sys')" Text="Boot filter SYS was not found in $(BootFilterPackageOutput)." />
		<Error Condition="'$(BuildDriver)' == 'true' AND !Exists('$(BootFilterPackageOutput)\xdows-security-bootfilter.cat') AND !Exists('$(BootFilterPackageOutput)\Xdows-Security-BootFilter.cat')" Text="Boot filter CAT was not found in $(BootFilterPackageOutput)." />
		<Error Condition="!Exists('$(XdowsModelInvokerRoot)\Models\Xdows-Model.onnx')" Text="Model assets were not found in $(XdowsModelInvokerRoot)\Models. Build Xdows-Model with MSBuild for $(Configuration)|$(Platform)." />

		<Copy SourceFiles="@(XdowsModelFiles)" DestinationFolder="$(OutDir)Models" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(NativeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(DriverFiles)" DestinationFiles="@(DriverFiles->'$(OutDir)Driver\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(DriverFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(BootFilterFiles)" DestinationFiles="@(BootFilterFiles->'$(OutDir)Driver\BootFilter\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="VerifyPackagedDriver" AfterTargets="CollectDriverAndModelAssets" Condition="'$(BuildDriver)' == 'true' AND Exists('$(DriverPackageOutput)\Xdows-Security-Driver.sys') AND Exists('$(OutDir)Driver\Xdows-Security-Driver.sys')">
		<GetFileHash Files="$(DriverPackageOutput)\Xdows-Security-Driver.sys">
			<Output TaskParameter="Items" ItemName="SourceDriverHash" />
		</GetFileHash>
		<GetFileHash Files="$(OutDir)Driver\Xdows-Security-Driver.sys">
			<Output TaskParameter="Items" ItemName="PackagedDriverHash" />
		</GetFileHash>
		<PropertyGroup>
			<SourceDriverHashValue>%(SourceDriverHash.FileHash)</SourceDriverHashValue>
			<PackagedDriverHashValue>%(PackagedDriverHash.FileHash)</PackagedDriverHashValue>
		</PropertyGroup>
		<Error Condition="'$(SourceDriverHashValue)' != '$(PackagedDriverHashValue)'" Text="Packaged Xdows Security Driver hash does not match the current driver build output." />
	</Target>

	<Target Name="VerifyPackagedNativeModel" AfterTargets="CollectDriverAndModelAssets" Condition="Exists('$(XdowsModelNativeOutput)\Xdows-Model-Native.dll') AND Exists('$(OutDir)Xdows-Model-Native.dll')">
		<GetFileHash Files="$(XdowsModelNativeOutput)\Xdows-Model-Native.dll">
			<Output TaskParameter="Items" ItemName="SourceNativeHash" />
		</GetFileHash>
		<GetFileHash Files="$(OutDir)Xdows-Model-Native.dll">
			<Output TaskParameter="Items" ItemName="PackagedNativeHash" />
		</GetFileHash>
		<PropertyGroup>
			<SourceNativeHashValue>%(SourceNativeHash.FileHash)</SourceNativeHashValue>
			<PackagedNativeHashValue>%(PackagedNativeHash.FileHash)</PackagedNativeHashValue>
		</PropertyGroup>
		<Error Condition="'$(SourceNativeHashValue)' != '$(PackagedNativeHashValue)'" Text="Packaged Xdows Model native hash does not match the current native build output." />
	</Target>

	<Target Name="AddDriverAndModelAssetsToPublish" BeforeTargets="ComputeFilesToPublish" Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'ARM64'">
		<ItemGroup>
			<PublishNativeFiles Include="$(XdowsModelNativeOutput)\Xdows-Model-Native.dll" />
			<PublishDriverFiles Include="$(DriverPackageOutput)\**\*" Condition="Exists('$(DriverPackageOutput)')" />
			<PublishBootFilterFiles Include="$(BootFilterPackageOutput)\**\*" Condition="Exists('$(BootFilterPackageOutput)')" />
			<ResolvedFileToPublish Include="@(PublishNativeFiles)" Condition="Exists('%(PublishNativeFiles.Identity)')">
				<RelativePath>%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Include="@(PublishDriverFiles)" Condition="Exists('%(PublishDriverFiles.Identity)')">
				<RelativePath>Driver\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Include="@(PublishBootFilterFiles)" Condition="Exists('%(PublishBootFilterFiles.Identity)')">
				<RelativePath>Driver\BootFilter\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Include="@(PublishDriverFiles)" Condition="Exists('%(PublishDriverFiles.Identity)')">
				<RelativePath>%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<Target Name="PublishDriverAndModelAssets" AfterTargets="Publish" Condition="'$(PublishDir)' != '' AND ('$(Platform)' == 'x64' OR '$(Platform)' == 'ARM64')">
		<ItemGroup>
			<PublishModelFiles Include="$(XdowsModelInvokerRoot)\Models\*.onnx" />
			<PublishModelFiles Include="$(XdowsModelInvokerRoot)\Models\*.json" />
			<PublishNativeFiles Include="$(XdowsModelNativeOutput)\Xdows-Model-Native.dll" />
			<PublishNativeFiles Include="$(XdowsModelNativeOutput)\onnxruntime.dll" />
			<PublishNativeFiles Include="$(XdowsModelNativeOutput)\onnxruntime_providers_shared.dll" />
			<PublishDriverFiles Include="$(DriverPackageOutput)\**\*" Condition="Exists('$(DriverPackageOutput)')" />
			<PublishBootFilterFiles Include="$(BootFilterPackageOutput)\**\*" Condition="Exists('$(BootFilterPackageOutput)')" />
		</ItemGroup>

		<Copy SourceFiles="@(PublishModelFiles)" DestinationFolder="$(PublishDir)Models" SkipUnchangedFiles="true" Condition="Exists('%(PublishModelFiles.Identity)')" />
		<Copy SourceFiles="@(PublishNativeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(PublishNativeFiles.Identity)')" />
		<Copy SourceFiles="@(PublishDriverFiles)" DestinationFiles="@(PublishDriverFiles->'$(PublishDir)Driver\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(PublishDriverFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(PublishBootFilterFiles)" DestinationFiles="@(PublishBootFilterFiles->'$(PublishDir)Driver\BootFilter\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>
</Project>
