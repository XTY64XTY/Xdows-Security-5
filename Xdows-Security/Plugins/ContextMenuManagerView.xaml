<UserControl
    x:Class="Xdows_Security.Views.ContextMenuManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Xdows_Security.Services"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0">
            <CommandBar.Content>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="上下文菜单管理"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Margin="12,16,0,0"
                               FontSize="16"/>
                    <ComboBox x:Name="ScopeCombo"
                              AutomationProperties.AutomationId="ContextMenuScopeCombo"
                              Grid.Column="1"
                              Margin="16,12,0,0"
                              Width="180"
                              SelectionChanged="ScopeCombo_SelectionChanged"/>
                    <ToggleSwitch x:Name="ThirdPartyToggle"
                                  AutomationProperties.AutomationId="ContextMenuThirdPartyToggle"
                                  Grid.Column="2"
                                  Margin="16,8,0,0"
                                  MinWidth="0"
                                  OffContent="全部项"
                                  OnContent="仅第三方"
                                  Toggled="ThirdPartyToggle_Toggled"/>
                    <AutoSuggestBox x:Name="SearchBox"
                                    AutomationProperties.AutomationId="ContextMenuSearchBox"
                                    Grid.Column="3"
                                    PlaceholderText="搜索名称、命令行或注册表路径..."
                                    HorizontalAlignment="Center"
                                    MinWidth="260"
                                    Margin="16,12,0,8"
                                    TextChanged="SearchBox_TextChanged"
                                    QueryIcon="Find"/>
                </Grid>
            </CommandBar.Content>
            <AppBarButton AutomationProperties.AutomationId="ContextMenuRefreshButton" Icon="Refresh" Label="刷新列表" Click="Refresh_Click"/>
            <AppBarToggleButton x:Name="ClassicMenuToggle"
                                AutomationProperties.AutomationId="ContextMenuClassicToggle"
                                Label="经典上下文菜单"
                                Click="ClassicMenuToggle_Click">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8A9;"/>
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton AutomationProperties.AutomationId="ContextMenuOpenRegeditButton" Label="打开注册表位置" Click="OpenRegedit_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B7;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton AutomationProperties.AutomationId="ContextMenuDeleteButton" Label="删除菜单项" Click="Delete_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE107;"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <StackPanel Grid.Row="1" Margin="16,8,16,0">
            <ProgressBar x:Name="LoadingBar"
                         IsIndeterminate="True"
                         Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Row="2" Padding="16,8,16,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="名称" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="位置" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="2" Text="类型" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="3" Text="命令行 / 模块" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="4" Text="来源" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="5" Text="启用" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
        </Grid>

        <ListView x:Name="MenuList"
                  AutomationProperties.AutomationId="ContextMenuList"
                  Grid.Row="3"
                  SelectionMode="Single"
                  DoubleTapped="MenuList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:ContextMenuEntry">
                    <Grid Padding="0,4" ToolTipService.ToolTip="{x:Bind RegistryPath}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind RegistryPath}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Scope}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Kind}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Target}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind Source}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ToggleSwitch Grid.Column="5"
                                      MinWidth="60"
                                      HorizontalAlignment="Center"
                                      IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                      Toggled="MenuToggle_Toggled"/>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="启用 / 禁用" Click="ToggleSelected_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73E;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="打开注册表位置" Click="OpenRegedit_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="复制命令行" Click="CopyTarget_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="删除菜单项" Click="Delete_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE107;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
