<UserControl
    x:Class="Xdows_Security.Views.ProcessManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Xdows_Security.Views"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0">
            <CommandBar.Content>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock l:Uids.Uid="ProcessManager_Title"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Margin="12,16,0,0"
                               FontSize="16"/>
                    <ComboBox x:Name="SortCombo"
                              AutomationProperties.AutomationId="ProcessManagerSortCombo"
                              Grid.Column="1"
                              Margin="16,12,0,0"
                              SelectionChanged="SortCombo_SelectionChanged"
                              Width="120">
                        <ComboBoxItem l:Uids.Uid="ProcessManager_Name" Tag="Name"/>
                        <ComboBoxItem Content="PID" Tag="Id"/>
                        <ComboBoxItem l:Uids.Uid="ProcessManager_Memory" Tag="Memory"/>
                        <ComboBoxItem l:Uids.Uid="ProcessManager_Threads" Tag="Threads"/>
                        <ComboBoxItem l:Uids.Uid="ProcessManager_Handles" Tag="Handles"/>
                    </ComboBox>
                    <StackPanel Grid.Column="2"
                                Margin="16,8,0,0"
                                Orientation="Horizontal"
                                Spacing="16">
                        <ToggleSwitch x:Name="ViewModeToggle"
                                      AutomationProperties.AutomationId="ProcessManagerTreeModeToggle"
                                      MinWidth="0"
                                      l:Uids.Uid="ProcessManager_ViewModeToggle"
                                      Toggled="ViewModeToggle_Toggled"/>
                        <ToggleSwitch x:Name="DriverModeToggle"
                                      x:Uid="ProcessManager_DriverModeToggle"
                                      AutomationProperties.AutomationId="ProcessManagerDriverModeToggle"
                                      MinWidth="0"
                                      Toggled="DriverModeToggle_Toggled"/>
                    </StackPanel>
                    <AutoSuggestBox x:Name="SearchBox"
                                    AutomationProperties.AutomationId="ProcessManagerSearchBox"
                                    Grid.Column="3"
                                    l:Uids.Uid="ProcessManager_Search"
                                    HorizontalAlignment="Center"
                                    MinWidth="260"
                                    Margin="16,12,0,8"
                                    TextChanged="SearchBox_TextChanged"
                                    QueryIcon="Find"/>
                </Grid>
            </CommandBar.Content>
            <AppBarButton AutomationProperties.AutomationId="ProcessManagerRefreshButton" Icon="Refresh" l:Uids.Uid="ProcessManager_Refresh" Click="Refresh_Click"/>
            <AppBarButton AutomationProperties.AutomationId="ProcessManagerTerminateButton" Icon="Cancel" l:Uids.Uid="ProcessManager_Terminate" Click="Kill_Click"/>
            <AppBarButton AutomationProperties.AutomationId="ProcessManagerSuspendButton" l:Uids.Uid="ProcessManager_Suspend" Click="Suspend_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE769;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton AutomationProperties.AutomationId="ProcessManagerResumeButton" l:Uids.Uid="ProcessManager_Resume" Click="Resume_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE768;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton AutomationProperties.AutomationId="ProcessManagerDetailsButton" l:Uids.Uid="ProcessManager_Details" Click="ShowProcessDetail_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid x:Name="ListHeader" Grid.Row="1" Padding="16,8,16,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" l:Uids.Uid="ProcessManager_Name" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="PID" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="2" l:Uids.Uid="ProcessManager_Threads" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="3" l:Uids.Uid="ProcessManager_Handles" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="4" l:Uids.Uid="ProcessManager_Memory" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="ProcessList" AutomationProperties.AutomationId="ProcessManagerList" SelectionMode="Single" DoubleTapped="ShowProcessDetail_Click">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ProcessInfoEx">
                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ThreadCount}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind HandleCount}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Memory}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem l:Uids.Uid="ProcessManager_Refresh" Click="Refresh_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem l:Uids.Uid="ProcessManager_Details" Click="ShowProcessDetail_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem l:Uids.Uid="ProcessManager_SuspendProcess" Click="Suspend_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE769;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem l:Uids.Uid="ProcessManager_ResumeProcess" Click="Resume_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem l:Uids.Uid="ProcessManager_Terminate" Click="Kill_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xF140;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TreeView x:Name="ProcessTree" AutomationProperties.AutomationId="ProcessManagerTree" Visibility="Collapsed" DoubleTapped="ShowProcessDetail_Click"/>

            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="Visible">
                <ProgressRing IsActive="True" Width="40" Height="40"/>
                <TextBlock l:Uids.Uid="ProcessManager_Loading" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
