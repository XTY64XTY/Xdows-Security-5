<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helper\Helper.csproj" />
    <ProjectReference Include="..\TrustQuarantine\TrustQuarantine.csproj" />
    <ProjectReference Include="..\Xdows-Local\Xdows-Local.csproj" />
    <ProjectReference Include="..\..\Xdows-Model\Xdows-Model-Invoker\Xdows-Model-Invoker.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.29" />
  </ItemGroup>

  <ItemGroup>
    <!--
      模型与阈值清单的布局约定见 Xdows-Model 的 ModelLayout.ModelDirectoryName：
      源在 Xdows-Model-Invoker\Models\，推理端（托管 ModelInvoker.EnsureModelAvailable
      与原生 ResolveModelPath）都按 <程序集目录>\Models\ 查找。
      这里必须把同样的相对目录搬到输出目录，不能摊平到根目录，否则推理端找不到模型。
    -->
    <Content Include="..\..\Xdows-Model\Xdows-Model-Invoker\Models\*.onnx" Condition="Exists('..\..\Xdows-Model\Xdows-Model-Invoker\Models')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Models\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\Xdows-Model\Xdows-Model-Invoker\Models\*.json" Condition="Exists('..\..\Xdows-Model\Xdows-Model-Invoker\Models')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Models\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="RemoveDia2LibFromPublish" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::new('%(Filename)').StartsWith('Dia2Lib'))" />
    </ItemGroup>
  </Target>

</Project>
